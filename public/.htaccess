# Clean&Fresh — React SPA routing on Apache/Hostinger
# Toutes les URLs sont renvoyees vers index.html (client-side routing TanStack Router)

Options -MultiViews
RewriteEngine On

# HTTPS force (decommenter une fois le SSL active sur Hostinger)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301 redirects — anciennes URLs WordPress courtes → nouvelles URLs React
Redirect 301 /nettoyage-canape /nettoyage-canape-toulouse
Redirect 301 /nettoyage-canape/ /nettoyage-canape-toulouse
Redirect 301 /nettoyage-tapis /nettoyage-tapis-toulouse
Redirect 301 /nettoyage-tapis/ /nettoyage-tapis-toulouse
Redirect 301 /nettoyage-matelas /nettoyage-matelas-toulouse
Redirect 301 /nettoyage-matelas/ /nettoyage-matelas-toulouse
Redirect 301 /nettoyage-de-fin-de-chantier /nettoyage-de-fin-de-chantier-toulouse
Redirect 301 /nettoyage-de-fin-de-chantier/ /nettoyage-de-fin-de-chantier-toulouse

# Servir les fichiers/dossiers existants directement (assets JS, CSS, images...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Toutes les autres requetes -> index.html
RewriteRule ^ index.html [L]

# Cache long terme pour les assets hashes (Vite genere des noms uniques)
<FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Pas de cache pour index.html (pour les mises a jour immediates)
<FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>
